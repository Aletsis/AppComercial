<Window x:Class="AppComercial.ServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="CONTPAQi REST API Manager" Height="500" Width="700"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource MaterialDesignDarkBackground}" Grid.Column="0">
            <StackPanel Margin="20">
                <TextBlock Text="API SERVER" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,30" HorizontalAlignment="Center"/>
                
                <materialDesign:PackIcon Kind="ServerNetwork" Width="80" Height="80" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock x:Name="TxtStatus" Text="DETENIDO" Foreground="Tomato" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <Button x:Name="BtnStart" Content="INICIAR API" Height="45" Margin="0,0,0,15" Background="LimeGreen" BorderBrush="LimeGreen" Foreground="White" Click="BtnStart_Click"/>
                <Button x:Name="BtnStop" Content="DETENER API" Height="45" IsEnabled="False" Margin="0,0,0,15" Background="Tomato" BorderBrush="Tomato" Foreground="White" Click="BtnStop_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Content (Tabs) -->
        <TabControl Grid.Column="1" Background="Transparent" BorderThickness="0">
            <!-- Pestaña Log -->
            <TabItem Header="Consola de Servidor">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Url de Escucha: " FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtUrl" Text="http://localhost:5271" Width="200" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Background="#1E1E1E" CornerRadius="4">
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtLog" Foreground="LightGreen" FontFamily="Consolas" FontSize="12" Margin="10" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            
            <!-- Pestaña Configuración CONTPAQi -->
            <TabItem Header="Configuración CONTPAQi">
                <StackPanel Margin="20">
                    
                    <TextBlock Text="Sistema CONTPAQi" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CmbSistema" Margin="0,0,0,20"
                              materialDesign:HintAssist.Hint="Selecciona el sistema"
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}">
                        <ComboBoxItem Content="CONTPAQi Comercial Premium" Tag="Comercial" IsSelected="True"/>
                        <ComboBoxItem Content="CONTPAQi Factura Electrónica" Tag="FacturaElectronica"/>
                    </ComboBox>

                    <TextBlock Text="Directorio de Empresa" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtDirectorioEmpresa"
                                 Grid.Column="0"
                                 materialDesign:HintAssist.Hint="Ruta Ejemplo: C:\Compac\Empresas\..."
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 Margin="0,0,8,0"/>
                        <Button x:Name="BtnBrowseEmpresa"
                                Grid.Column="1"
                                ToolTip="Seleccionar carpeta de empresa"
                                Width="40" Height="40"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="BtnBrowseEmpresa_Click"
                                Padding="4">
                            <materialDesign:PackIcon Kind="FolderOpen" Width="20" Height="20"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="Usuario Comercial" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtUsuario" Text="SUPERVISOR" Margin="0,0,0,20" materialDesign:HintAssist.Hint="Usuario" Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                    <TextBlock Text="Contraseña Comercial" FontWeight="Bold" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="TxtPassword" Margin="0,0,0,30" materialDesign:HintAssist.Hint="Contraseña (dejar en blanco si no tiene)" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"/>

                    <Button Content="GUARDAR CONFIGURACIÓN" HorizontalAlignment="Right" Width="200" Click="BtnSaveConfig_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
